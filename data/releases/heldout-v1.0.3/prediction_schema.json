{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/arabic-tool-calling/prediction-schema-1.0.0.json",
  "title": "Tool-use prediction record",
  "description": "One unmodified Stage-1 decision and optional Stage-2 Arabic response. Derived parses and scores are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prediction_schema_version",
    "run_id",
    "variant_id",
    "decision_output",
    "final_response",
    "generation_error"
  ],
  "properties": {
    "prediction_schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^pair_[0-9]{4,}_(msa|saudi_general)$"
    },
    "decision_output": {
      "type": "string"
    },
    "final_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation_error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
